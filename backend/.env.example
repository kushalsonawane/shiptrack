# Copy to .env and fill in. All values are optional - sane defaults apply.

# --- Core ---
SHIPTRACK_SECRET=
DATABASE_URL=

# --- Company profile (printed on the tax invoice / e-way bill) ---
COMPANY_NAME=Shreemaruti Instruments Pvt. Ltd.
COMPANY_ADDRESS=Royal Industrial Hub, Survey No. 30/32/2/2/2, NH No. 8, Gala No. 15, Opp. Jai Research Foundation, Valvada, Vapi, Gujarat - 396105
COMPANY_GSTIN=
COMPANY_PAN=
COMPANY_CITY=Vapi
COMPANY_STATE=Gujarat
COMPANY_STATE_CODE=24
COMPANY_PHONE=+91 9316336117
COMPANY_EMAIL=sales@smiplvapi.com
INVOICE_PREFIX=SMIPL

# --- E-Way Bill provider ---
# sandbox = locally generated numbers for development (default)
# live    = call the official/GSP endpoints below
EWB_MODE=sandbox
EWB_BASE_URL=
EWB_USERNAME=
EWB_PASSWORD=
EWB_CLIENT_ID=
EWB_CLIENT_SECRET=
AUTO_EWB=true
AUTO_SHIPMENT=true
NOTIFY_ON_EWB=true
REQUIRED_DISPATCH_DOCS=Tax Invoice,E-Way Bill

# --- Alerts (scheduled notification rules) ---
ALERT_EMAIL=dispatch@smiplvapi.com
ALERT_PURCHASE_EMAIL=purchase@smiplvapi.com
ALERT_INTERVAL_MINUTES=30

# --- Backups ---
BACKUP_RETENTION=14

# --- Email ---
# Pick ONE transport. The app detects it from whichever key is set
# (RESEND_API_KEY, then BREVO_API_KEY, then SMTP_HOST), or force it with EMAIL_PROVIDER.
#
# Render's free tier blocks outbound SMTP, so on Render use Resend or Brevo (HTTPS):
#   Resend: create a key at resend.com. Until you verify a domain, Resend only delivers to
#           the address your Resend account was created with (use that as EMAIL_REDIRECT_TO).
#   Brevo:  create an API key and verify the sender address under Senders & IP.
EMAIL_PROVIDER=
RESEND_API_KEY=
BREVO_API_KEY=
# Sender shown to recipients. Resend: onboarding@resend.dev until your domain is verified.
EMAIL_FROM=
EMAIL_FROM_NAME=Shreemaruti Instruments
# Failed emails are retried automatically on every scheduled cycle, this many times.
EMAIL_MAX_RETRIES=3

# SMTP fallback (local catcher or a company mail server; fine on a laptop, blocked on Render free)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_STARTTLS=true

# Test mode: every email is delivered ONLY to this address. Remove it to send to real contacts.
EMAIL_REDIRECT_TO=
EMAIL_REDIRECT_ALLOW=
